# ─────────────────────────────────────────────────────────────────────────────
# SAKHI Backend — Required Environment Variables
# Copy this file to .env and fill in your values before running the server.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# The port the Express server listens on.
PORT=5000

# Set to "production" in live environments.
# When NODE_ENV=production, JWT_SECRET MUST be set — server will refuse to
# start without it (startup guard in src/server.ts).
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/sakhi_db?schema=public"

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production. A long, random secret used to sign JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WARNING: In production, the server will exit immediately if this is missing.
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your deployed frontend. Added to the allowed CORS origins list.
# In development, http://localhost:3000 is always allowed by default.
CORS_ORIGIN=https://your-frontend-domain.com

# ── AI / Gemini ───────────────────────────────────────────────────────────────
# Google Gemini API key (used for AI chat and OCR).
# When missing or AI_PROVIDER=mock, a deterministic mock provider is used.
GEMINI_API_KEY=AIza_replace_with_real_gemini_key

# Which AI provider to use: "gemini" | "mock"
# Set to "gemini" for production real AI responses.
AI_PROVIDER=mock

# ── Storage ───────────────────────────────────────────────────────────────────
# Which storage provider to use for medical report file uploads: "gcs" | "local"
# Use "local" in development (files stored in bend/uploads/).
# Use "gcs" in production.
STORAGE_PROVIDER=local

# ── Google Cloud Storage (only required when STORAGE_PROVIDER=gcs) ────────────
# The GCS bucket name. Must be a PRIVATE bucket — never enable public access.
GCS_BUCKET_NAME=sakhi-medical-reports

# Google Cloud project ID.
GCP_PROJECT_ID=your-gcp-project-id

# Service account email with Storage Object Admin role.
GCP_CLIENT_EMAIL=sakhi-storage@your-gcp-project-id.iam.gserviceaccount.com

# Service account private key in PEM format.
# Newlines must be represented as \n (literal backslash-n) in .env files.
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
